REDIS_URL=redis://localhost:6379/0
REDIS_CHANNEL=agent_events
DATABASE_URL=postgresql://user:pass@localhost:5432/agent_monitor
WEBSOCKET_ORIGINS=*

# Optional. If omitted, backend creates .agent_secret.key locally.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENT_SECRET_KEY=

# Required for mandatory AI qualification comments in the qualification queue.
GEMINI_API_KEY=
GEMINI_BACKUP_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Options: race_first_success, primary_only
GEMINI_REQUEST_STRATEGY=race_first_success
